meta {
  name: 新增接入点
  type: http
  seq: 14
}

post {
  url: {{relay_url}}/api/endpoints
  body: json
  auth: bearer
}

auth:bearer {
  token: <device-credential>
}

body:json {
  {
    "name": "示例接入点",
    "protocol": "chat_completions",
    "models": [
      {
        "provider_id": "<provider-id>",
        "upstream_model": "example-model"
      }
    ]
  }
}
